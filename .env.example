# Copy to .env and fill in:   cp .env.example .env     (Windows: copy .env.example .env)
# .env holds real credentials and is gitignored - never commit it, never paste it into a ticket.
# Run `qa-pipeline doctor` afterwards to check what is set (it prints names, never values).
#
# Precedence, highest first:  CLI flag  >  shell environment  >  this file  >  profile project.json  >  built-in default
# Lines starting with # are optional.

# ---------------------------------------------------------------- AI provider (REQUIRED)
AI_PROVIDER=anthropic            # anthropic | openai | azure_openai | openrouter | ollama
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=
# AZURE_OPENAI_DEPLOYMENT=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=
# OPENROUTER_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# MODEL_TESTCASE_WRITER=         # override the model for one agent

# ---------------------------------------------------------------- application under test (REQUIRED to execute)
# TEST_ENV picks which pair below is used:  local -> LOCAL_APP_*   central -> CENTRAL_APP_*
# If the prefixed one is not set, the plain APP_BASE_URL / APP_TEST_USER / APP_TEST_PASSWORD is used.
TEST_ENV=local
LOCAL_APP_BASE_URL=https://your-app.example.com
LOCAL_APP_TEST_USER=
LOCAL_APP_TEST_PASSWORD=
# CENTRAL_APP_BASE_URL=
# CENTRAL_APP_TEST_USER=
# CENTRAL_APP_TEST_PASSWORD=

# ---------------------------------------------------------------- JIRA (optional - needed only to read stories / upload tests)
# JIRA_BASE_URL=https://yourcompany.atlassian.net       # self-hosted: https://jira.yourcompany.com
# JIRA_API_TOKEN=
# JIRA_EMAIL=                    # Atlassian Cloud only (basic auth); self-hosted uses a bearer token
# JIRA_AUTH_TYPE=                # basic | bearer  (auto-detected from the URL when blank)
# JIRA_API_VERSION=              # 2 | 3          (auto-detected when blank)
# JIRA_TEST_ISSUE_TYPE=Test
# JIRA_TEST_MANAGEMENT_TOOL=     # e.g. zephyr
# ZEPHYR_API_TOKEN=
# JIRA_FEATURE_LINK=             # a Feature/Epic/Story key or link to walk (stories + linked Test issues)

# ---------------------------------------------------------------- Figma (optional)
# FIGMA_API_TOKEN=

# ---------------------------------------------------------------- Test Case Writer defaults (optional)
# These are DEFAULTS for the matching CLI flags; the flag always wins. Each value taken from here is
# printed with its variable name before use. --story / --epic are deliberately NOT settable here.
# TESTCASE_WRITER_DESIGN_DOC=
# TESTCASE_WRITER_FIGMA_URL=
# TESTCASE_WRITER_API_SPEC=
# TESTCASE_WRITER_IMPORT_FILE=
# TESTCASE_WRITER_REFERENCE_CASES=
# TESTCASE_WRITER_KNOWLEDGE_DIR=     # blank = profiles/<app>/input/docs

# ---------------------------------------------------------------- browser / Playwright MCP (optional)
# USE_PLAYWRIGHT_MCP=true         # use the Playwright MCP server for DOM inspection (preferred in CI)
# PLAYWRIGHT_MCP_URL=
# DOM_INSPECT_HEADLESS=new        # blank = try headed, fall back to new headless; 'new' goes straight to headless (CI)

# ---------------------------------------------------------------- tuning (optional)
# EXECUTOR_TIMEOUT_SECONDS=1800      # kill a Playwright run after this long
# QA_GLOBAL_TIMEOUT_MS=1620000       # Playwright's own whole-run limit (inside the generated suite)
# ALLURE_TIMEOUT_SECONDS=120
# QA_MAX_PARALLEL_CHUNKS=4
# QA_SKIP_MODEL_PREFLIGHT=0
