# --- Secrets: never commit ------------------------------------------------
.env
.env.*
!.env.example
# Playwright login sessions (live cookies/tokens) in any workspace
**/.auth/
*.storageState.json

# --- Generated / local data ----------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Per-run output, and the throwaway tsconfig the compile gate writes into
# a generated workspace (removed on success; ignored so an interrupted run
# cannot leave one in a commit).
context/
runs/
tsconfig.qa-typecheck-*.json

# Generated Playwright repos are their OWN git repositories (see
# workspaces/<app>/), not part of this one.
workspaces/
# NOTE: profiles/*/brain/ledger.json is deliberately NOT ignored — it is the
# accumulated knowledge of every run (see qa_pipeline/profiles.py).
# Hand-made backups and archives.
backup/
*.zip

# Regenerated by the tools that create them.
.pytest_cache/
.ruff_cache/
.mypy_cache/
allure-results/
allure-report/
playwright-report/
test-results/
node_modules/
